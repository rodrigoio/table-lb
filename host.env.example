# Machine-specific configuration for ./start.sh.
#   cp host.env.example host.env   # then uncomment what you need
# Precedence: environment variables > host.env > defaults of start.sh.
# host.env is not versioned; every run records its effective values in
# results/<campaign>/host.txt and in each run's meta.env.

# --- PostgreSQL container ----------------------------------------------------
# PROFILE=auto        half of the CPUs, a quarter of the RAM (default)
# PROFILE=reference   limits of the 2 vCPU / 2 GB development VM (pilot numbers)
#PROFILE=auto
#PG_CPUS=8
#PG_MEM=16g
#PG_SHARED_BUFFERS=4GB
#PG_EFFECTIVE_CACHE_SIZE=12GB
#PG_MAX_CONNECTIONS=        # computed per run from the scenario when empty

# --- What to run -------------------------------------------------------------
#SCENARIOS="c1 c2 c3 c5"    # c2 includes C4 (b-slots1); c5 includes b-slots64
#REPS_C1=3
#REPS_C2=3
#REPS_C4=2
#REPS_C3=2
#REPS_C5=2
#REPS_C5_VARIANTS=1
# Long-cycle B labels: the consumer keeps the hot buffer open for at least this
# long between switches (MIN_CYCLE_MS). Labels b-<n>s (c2, c3) and b-1rt-<n>s
# (c1, c2, c3, c5); 0 = do not run them.
#LONG_CYCLE_MS=30000
#SKIP_TESTS=0

# --- Rates of C2/C3 ------------------------------------------------------------
# By default a 2-minute saturation pilot of A and B sets the sustained rate to
# CALIBRATION_FRACTION × min(A, B) and the burst to 2× that rate.
#CALIBRATION_FRACTION=0.6
# Fixed rates instead of calibration (the development VM used 2000 / 4000):
#C2_PRODUCER_RATE=2000
#C3_PRODUCER_RATE=2000
#C3_BURST_RATE=4000

# --- C5: massive concurrency ---------------------------------------------------
# Concurrent producer connections (closed loop) through PgBouncer. One pgbench
# container per ≤ 50k connections is chosen automatically when
# C5_PRODUCER_REPLICAS is empty. Needs ≈ 48 KB RAM per connection and the
# kernel limits applied by `sudo ./start.sh setup`.
#C5_PRODUCER_CLIENTS=100000
#C5_PRODUCER_REPLICAS=
#C5_PRODUCER_THREADS=8          # pgbench threads per container
#C5_PGBOUNCER_PROCESSES=4       # PgBouncer processes sharing port 6432
#C5_PGBOUNCER_POOL_SIZE=16      # server connections per process
#C5_LOCK_SLOTS=1024             # B: controller rows (keep ≫ processes × pool size)
#C5_DURATION=600
#C5_WARMUP=120

# --- Any scenario variable can be overridden the same way -----------------------
#   <SCENARIO>_<VAR>=value, e.g. C1_PRODUCER_CLIENTS=64 C1_PRODUCER_THREADS=8
