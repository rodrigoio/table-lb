DESCRIPTION="C1 — maximum ingestion: 16 producers without rate limit, consumers active, no readers. Measures producer throughput and how far each consumer falls behind at saturation. Labels: a, b, b-1rt (B with the single-round-trip producer, producer-1rt.sql), b-1rt-30s (b-1rt with MIN_CYCLE_MS=30000: the consumer keeps the hot buffer open for at least 30 s between switches)."
DURATION=300
WARMUP=60
PRODUCER_CLIENTS=16
PRODUCER_THREADS=2
PRODUCER_RATE=
WINDOW=5000
READERS=0
SEED_ORDERS=1000000
