DESCRIPTION="C5 — massive concurrency: PRODUCER_CLIENTS concurrent producer connections in closed loop (each client sends its next event as soon as the previous one commits), spread over PRODUCER_REPLICAS pgbench containers and multiplexed by PgBouncer (transaction pooling, PGBOUNCER_PROCESSES × PGBOUNCER_POOL_SIZE server connections), plus business readers. Millions of events per run; producer latency includes the wait for a pooled server connection. Labels: a; b (LOCK_SLOTS=1024, 16 slots per server connection; BEGIN / FOR SHARE / INSERT / COMMIT holds a pooled connection for 4 round trips); b-1rt (single-statement routing, producer-1rt.sql: 1 round trip); b-slots64 (64 slots: several pooled connections per controller row)."
# Load: 100k connections for 10 min (WARMUP also covers the connection ramp).
DURATION=600
WARMUP=120
PRODUCER_CLIENTS=100000
PRODUCER_REPLICAS=4
PRODUCER_THREADS=8
PRODUCER_RATE=
PRODUCER_VIA=pgbouncer
# pgbench -M prepared prepares synchronously and deadlocks behind a
# transaction pooler (see common/pgbench/run-pgbench.sh): extended protocol.
QUERY_MODE=extended
PGBOUNCER_PROCESSES=4
PGBOUNCER_POOL_SIZE=16
# Behind a pooler the lockers of a controller row are the pooled server
# connections, not the clients: keep slots well above PROCESSES × POOL_SIZE.
LOCK_SLOTS=1024
# Each client sends few events (≈ throughput × DURATION / clients): a small
# window still spaces the 4 phases of an order by WINDOW events of the client.
WINDOW=20
SAMPLING=0.01
READERS=1
READER_CLIENTS=4
READER_RATE=200
SEED_ORDERS=1000000
DRAIN_TIMEOUT=3600
