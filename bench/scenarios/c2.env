DESCRIPTION="C2 — sustained load: 16 producers at 2000 tx/s in total (≈64% of B's and ≈34% of A's saturation throughput in the pilot) plus business readers at 200 tx/s on orders. Labels: a (CLEANUP_MODE=update), a-delete (CLEANUP_MODE=delete), b (LOCK_SLOTS=64, one controller row per producer), b-slots1 (C4: LOCK_SLOTS=1, every producer shares one controller row), b-30s and b-1rt-30s (b and b-1rt with MIN_CYCLE_MS=30000: at least 30 s between switches)."
DURATION=600
WARMUP=60
PRODUCER_CLIENTS=16
PRODUCER_THREADS=2
PRODUCER_RATE=2000
WINDOW=5000
READERS=1
READER_CLIENTS=4
READER_RATE=200
